# Upstream Postiz tracking state. Read by sync-status.sh. Plain KEY=VALUE, no spaces around "=".
UPSTREAM_REPO=https://github.com/gitroomhq/postiz-app.git
UPSTREAM_REMOTE=upstream
UPSTREAM_BRANCH=main

# BASE_SHA: the upstream commit our tree was last built from by a full merge. Never moves unless we do another full merge.
# `git diff BASE_SHA HEAD` is therefore the exact list of what we changed (see divergences.md).
BASE_SHA=48490b815ddee008db8495933b0046f214c4d3da
BASE_DATE=2026-09-17
BASE_SUBJECT="feat(mcp): serve the ChatGPT app on /mcp-oauth-chatgpt"
OUR_MERGE_COMMIT=6cae8874c555a5df802d48d8bf02f1aa14097f35

# TRIAGED_THROUGH: every upstream change up to and including this commit has a decision in ledger.tsv
# (or is covered by the baseline row). Advance it with `sync-status.sh advance <sha>`; the script refuses if
# any change in between has no ledger row.
TRIAGED_THROUGH=48490b815ddee008db8495933b0046f214c4d3da
